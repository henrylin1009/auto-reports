__pycache__/
*.pyc
.DS_Store
~$*
.env
# 完整報表要入庫給網頁下載(CI 不重建);其餘 xlsx 忽略
*.xlsx
!銀行債券_完整報表.xlsx
.venv/
site/
output/
logs/
